<script>


// ============================================================
// ELEMENTOS
// ============================================================

const video =
    document.getElementById("display");


const canvas =
    document.getElementById("canvas");


const ctx =
    canvas.getContext("2d");


// Quando a pagina e aberta pelo Live Server (normalmente na porta 5500),
// as requisicoes precisam ir para o Flask, que roda na porta 5000.
const API_BASE_URL =
    window.location.port === "5000"
        ? ""
        : "http://" + (window.location.hostname || "127.0.0.1") + ":5000";



// ============================================================
// CONTROLE
// ============================================================

let processando = false;

let modoDemonstracao = false;

let intervaloDemo = null;

let intervaloAnalise = null;



// ============================================================
// ENERGIA
// ============================================================

const ENERGIA_POR_MOVIMENTO = 0.05;



// ============================================================
// INICIAR CÂMERA
// ============================================================

async function iniciarCamera() {

    try {

        const stream =
            await navigator.mediaDevices
                .getUserMedia({

                    video: {

                        width: {
                            ideal: 1280
                        },

                        height: {
                            ideal: 720
                        },

                        frameRate: {

                            ideal: 24,

                            max: 30
                        }

                    },

                    audio: false
                });


        video.srcObject =
            stream;


        await video.play();


        document.getElementById(
            "cameraStatus"
        ).innerText =
            "● CÂMERA ATIVA";


        document.getElementById(
            "statusTexto"
        ).innerText =
            "SISTEMA ONLINE";


        iniciarAnalise();

    }


    catch (erro) {

        console.error(
            "Erro ao acessar câmera:",
            erro
        );


        document.getElementById(
            "cameraStatus"
        ).innerText =
            "● CÂMERA OFFLINE";


        document.getElementById(
            "statusTexto"
        ).innerText =
            "CÂMERA OFFLINE";

    }

}



// ============================================================
// ANÁLISE DA CÂMERA
// ============================================================
//
// Antes:
//
// 5 análises por segundo.
//
// Agora:
//
// 2 análises por segundo.
//
// Isso diminui o trabalho do MediaPipe.
//
// A câmera continua fluida.
//

function iniciarAnalise() {

    if (intervaloAnalise) {

        clearInterval(
            intervaloAnalise
        );
    }


    intervaloAnalise =
        setInterval(

            function() {

                if (
                    !modoDemonstracao
                ) {

                    enviarFrameParaPython();

                }

            },

            500
        );
}



// ============================================================
// ENVIAR FRAME PARA PYTHON
// ============================================================

async function enviarFrameParaPython() {


    if (processando) {

        return;
    }


    if (
        video.readyState < 2
    ) {

        return;
    }


    processando = true;


    try {


        // ====================================================
        // CAPTURA
        // ====================================================

        canvas.width =
            Math.min(video.videoWidth || 1280, 1280);

        canvas.height =
            Math.min(video.videoHeight || 720, 720);


        ctx.drawImage(

            video,

            0,
            0,

            canvas.width,
            canvas.height
        );



        // ====================================================
        // JPEG
        // ====================================================

        const imagemBase64 =
            canvas.toDataURL(
                "image/jpeg",
                0.82
            );



        // ====================================================
        // ENVIA PARA FLASK
        // ====================================================

        const resposta =
            await fetch(
                API_BASE_URL + "/processar_frame",
                {

                    method: "POST",

                    headers: {

                        "Content-Type":
                            "application/json"
                    },

                    body:
                        JSON.stringify({

                            imagem:
                                imagemBase64
                        })
                }
            );


        if (!resposta.ok) {

            throw new Error(
                "HTTP " +
                resposta.status
            );
        }



        // ====================================================
        // RECEBE RESPOSTA
        // ====================================================

        const dados =
            await resposta.json();


        atualizarDashboard(
            dados
        );


        document.getElementById(
            "cameraStatus"
        ).innerText =
            "● ANÁLISE ATIVA";

    }


    catch (erro) {

        console.error(
            "Erro na análise:",
            erro
        );


        document.getElementById(
            "cameraStatus"
        ).innerText =
            "● ERRO NO SERVIDOR";
    }


    finally {

        processando =
            false;
    }

}



// ============================================================
// ATUALIZAR DASHBOARD
// ============================================================

function atualizarDashboard(
    dados
) {


    if (!dados.setores) {

        return;
    }



    // ========================================================
    // VALORES
    // ========================================================

    const A =
        Number(
            dados.setores["Setor A"] || 0
        );


    const B =
        Number(
            dados.setores["Setor B"] || 0
        );


    const C =
        Number(
            dados.setores["Setor C"] || 0
        );



    // ========================================================
    // NÚMEROS
    // ========================================================

    document.getElementById(
        "setorA"
    ).innerText = A;


    document.getElementById(
        "setorB"
    ).innerText = B;


    document.getElementById(
        "setorC"
    ).innerText = C;



    // ========================================================
    // GRÁFICO
    // ========================================================

    const maior =
        Math.max(
            A,
            B,
            C,
            1
        );


    document.getElementById(
        "barraA"
    ).style.width =
        (A / maior * 100) +
        "%";


    document.getElementById(
        "barraB"
    ).style.width =
        (B / maior * 100) +
        "%";


    document.getElementById(
        "barraC"
    ).style.width =
        (C / maior * 100) +
        "%";


    document.getElementById(
        "valorA"
    ).innerText = A;


    document.getElementById(
        "valorB"
    ).innerText = B;


    document.getElementById(
        "valorC"
    ).innerText = C;



    // ========================================================
    // NÍVEIS
    // ========================================================
    //
    // AGORA É POR VALOR ABSOLUTO.
    //
    // 0 - 5  = BAIXO
    // 6 - 15 = MÉDIO
    // 16+    = ALTO
    //
    // Assim, por exemplo:
    //
    // 2 movimentos = BAIXO
    //
    // mesmo que seja o maior setor.
    //

    atualizarNivel(
        "nivelA",
        A
    );


    atualizarNivel(
        "nivelB",
        B
    );


    atualizarNivel(
        "nivelC",
        C
    );



    // ========================================================
    // MAIOR SETOR
    // ========================================================

    const valoresSetores = [
        { nome: "Setor A", valor: A },
        { nome: "Setor B", valor: B },
        { nome: "Setor C", valor: C }
    ];


    const valorMaior =
        Math.max(A, B, C);


    const setoresMaiores = valoresSetores
        .filter(setor => setor.valor === valorMaior)
        .map(setor => setor.nome);


    const setorMaior =
        setoresMaiores.join(" E ");



    // ========================================================
    // RECOMENDAÇÃO
    // ========================================================

    if (

        A === 0 &&
        B === 0 &&
        C === 0

    ) {


        document.getElementById(
            "recomendacao"
        ).innerText =
            "AGUARDANDO FLUXO...";


        document.getElementById(
            "recomendacaoInfo"
        ).innerText =
            "Nenhum movimento detectado.";

    }


    else {


        document.getElementById(
            "recomendacao"
        ).innerHTML =

            "INSTALAR PISO PIEZOELÉTRICO NO " +

            '<span class="recomendacao-setor">' +

            setorMaior.toUpperCase() +

            "</span>";


        document.getElementById(
            "recomendacaoInfo"
        ).innerText =

            "Maior fluxo detectado: " +

            valorMaior +

            " movimentos.";

    }



    // ========================================================
    // ENERGIA
    // ========================================================

    const total =
        A + B + C;


    const energia =
        total *
        ENERGIA_POR_MOVIMENTO;


    document.getElementById(
        "energia"
    ).innerText =

        energia
            .toFixed(2)
            .replace(
                ".",
                ","
            );

}



// ============================================================
// NÍVEL DO SETOR
// ============================================================

function atualizarNivel(
    id,
    valor
) {


    const elemento =
        document.getElementById(
            id
        );


    elemento.className =
        "nivel";



    // ========================================================
    // BAIXO
    // ========================================================

    if (
        valor <= 5
    ) {

        elemento.classList.add(
            "baixo"
        );


        elemento.innerText =
            "🟢 BAIXO";


        return;
    }



    // ========================================================
    // MÉDIO
    // ========================================================

    if (
        valor <= 15
    ) {

        elemento.classList.add(
            "medio"
        );


        elemento.innerText =
            "🟡 MÉDIO";


        return;
    }



    // ========================================================
    // ALTO
    // ========================================================

    elemento.classList.add(
        "alto"
    );


    elemento.innerText =
        "🔴 ALTO";

}



// ============================================================
// ZERAR CONTAGEM
// ============================================================

async function zerarContagem() {


    const botao =
        document.getElementById(
            "btnReset"
        );


    try {


        botao.disabled =
            true;


        botao.innerText =
            "⏳ ZERANDO...";



        // ====================================================
        // PARA A ANÁLISE POR UM MOMENTO
        // ====================================================

        const analiseAnterior =
            intervaloAnalise;


        if (
            analiseAnterior
        ) {

            clearInterval(
                analiseAnterior
            );

            intervaloAnalise =
                null;
        }



        // ====================================================
        // ESPERA QUALQUER REQUISIÇÃO TERMINAR
        // ====================================================

        while (
            processando
        ) {

            await new Promise(
                function(resolve) {

                    setTimeout(
                        resolve,
                        50
                    );

                }
            );

        }



        // ====================================================
        // DESLIGA DEMONSTRAÇÃO
        // ====================================================

        modoDemonstracao =
            false;


        if (
            intervaloDemo
        ) {

            clearInterval(
                intervaloDemo
            );

            intervaloDemo =
                null;
        }



        // ====================================================
        // ENVIA RESET PARA PYTHON
        // ====================================================

        const resposta =
            await fetch(
                API_BASE_URL + "/zerar_contagem",
                {

                    method: "POST",

                    cache: "no-store"
                }
            );


        if (!resposta.ok) {

            throw new Error(
                "HTTP " +
                resposta.status
            );
        }


        const dados =
            await resposta.json();


        if (
            !dados.sucesso
        ) {

            throw new Error(
                "O servidor não confirmou o reset."
            );
        }



        // ====================================================
        // MOSTRA ZERO NA TELA
        // ====================================================

        atualizarDashboard({

            setores: {

                "Setor A": 0,

                "Setor B": 0,

                "Setor C": 0
            }

        });



        document.getElementById(
            "cameraStatus"
        ).innerText =
            "● CÂMERA ATIVA";



        // ====================================================
        // REINICIA ANÁLISE
        // ====================================================

        setTimeout(
            function() {

                if (
                    !modoDemonstracao
                ) {

                    iniciarAnalise();

                }

            },
            300
        );


        console.log(
            "Contagem zerada com sucesso!"
        );

    }


    catch (erro) {


        console.error(
            "Erro ao zerar:",
            erro
        );


        alert(
            "Erro ao zerar a contagem.\n\n" +
            "Verifique se o appmedia.py está rodando."
        );



        // Reinicia análise mesmo se houver erro

        if (
            !intervaloAnalise &&
            !modoDemonstracao
        ) {

            iniciarAnalise();
        }

    }


    finally {

        botao.disabled =
            false;


        botao.innerText =
            "🔄 ZERAR CONTAGEM";
    }

}



// ============================================================
// MODO DEMONSTRAÇÃO
// ============================================================

function alternarDemonstracao() {


    modoDemonstracao =
        !modoDemonstracao;


    const botao =
        document.getElementById(
            "btnDemo"
        );



    if (
        modoDemonstracao
    ) {


        // Para análise da câmera

        if (
            intervaloAnalise
        ) {

            clearInterval(
                intervaloAnalise
            );

            intervaloAnalise =
                null;
        }


        botao.innerText =
            "⏹ SAIR DA DEMONSTRAÇÃO";


        botao.classList.add(
            "ativo"
        );


        document.getElementById(
            "cameraStatus"
        ).innerText =
            "● MODO DEMONSTRAÇÃO";


        iniciarDemo();

    }


    else {


        botao.innerText =
            "🎮 MODO DEMONSTRAÇÃO";


        botao.classList.remove(
            "ativo"
        );


        document.getElementById(
            "cameraStatus"
        ).innerText =
            "● CÂMERA ATIVA";


        if (
            intervaloDemo
        ) {

            clearInterval(
                intervaloDemo
            );

            intervaloDemo =
                null;
        }


        iniciarAnalise();

    }

}



// ============================================================
// DEMONSTRAÇÃO
// ============================================================

function iniciarDemo() {


    let A = 2;

    let B = 4;

    let C = 1;



    // Mostra imediatamente

    atualizarDashboard({

        setores: {

            "Setor A": A,

            "Setor B": B,

            "Setor C": C

        }

    });



    intervaloDemo =
        setInterval(

            function() {


                A +=
                    Math.floor(
                        Math.random() * 3
                    );


                B +=
                    Math.floor(
                        Math.random() * 3
                    );


                C +=
                    Math.floor(
                        Math.random() * 2
                    );



                atualizarDashboard({

                    setores: {

                        "Setor A": A,

                        "Setor B": B,

                        "Setor C": C

                    }

                });

            },

            1500
        );

}



