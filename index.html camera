<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        FECART - Monitoramento Piezoelétrico
    </title>

    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {

            min-height: 100vh;

            background:
                radial-gradient(
                    circle at top,
                    #12352b,
                    #08110f 45%,
                    #040706 100%
                );

            color: white;

            font-family:
                Arial,
                Helvetica,
                sans-serif;

            padding: 25px;
        }


        /* ==================================================
           DASHBOARD
        ================================================== */

        .dashboard {

            width: 100%;

            max-width: 1150px;

            margin: auto;

            background: #0d1512;

            border:
                1px solid #20352d;

            border-radius: 20px;

            overflow: hidden;

            box-shadow:
                0 20px 60px
                rgba(0,0,0,0.55);
        }


        /* ==================================================
           CABEÇALHO
        ================================================== */

        .header {

            display: flex;

            justify-content:
                space-between;

            align-items: center;

            padding:
                25px 30px;

            border-bottom:
                1px solid #20352d;
        }


        .logo {

            display: flex;

            align-items: center;

            gap: 14px;
        }


        .logo-icon {

            font-size: 38px;

            filter:
                drop-shadow(
                    0 0 10px #00ff88
                );
        }


        .logo h1 {

            font-size: 24px;

            letter-spacing: 2px;
        }


        .logo p {

            margin-top: 5px;

            color: #84928d;

            font-size: 13px;
        }


        /* ==================================================
           STATUS
        ================================================== */

        .status {

            display: flex;

            align-items: center;

            gap: 9px;

            padding:
                10px 16px;

            border-radius: 30px;

            background:
                rgba(0,255,136,0.08);

            border:
                1px solid
                rgba(0,255,136,0.25);

            color: #00ff88;

            font-size: 13px;

            font-weight: bold;
        }


        .status-dot {

            width: 9px;

            height: 9px;

            border-radius: 50%;

            background: #00ff88;

            box-shadow:
                0 0 10px #00ff88;

            animation:
                pulse 1.5s infinite;
        }


        @keyframes pulse {

            0% {

                opacity: 1;

                transform:
                    scale(1);
            }

            50% {

                opacity: 0.4;

                transform:
                    scale(0.8);
            }

            100% {

                opacity: 1;

                transform:
                    scale(1);
            }
        }


        /* ==================================================
           CÂMERA
        ================================================== */

        .camera-section {

            padding:
                28px 30px 10px;
        }


        .section-title {

            color: #8c9994;

            font-size: 13px;

            letter-spacing: 1.5px;

            margin-bottom: 14px;
        }


        .camera {

            position: relative;

            width: 100%;

            max-width: 900px;

            aspect-ratio: 16 / 9;

            margin: auto;

            background: black;

            border-radius: 15px;

            overflow: hidden;

            border:
                2px solid #164c39;

            box-shadow:
                0 0 30px
                rgba(0,255,136,0.08);
        }


        #display {

            width: 100%;

            height: 100%;

            object-fit: cover;

            display: block;
        }


        .camera-overlay {

            position: absolute;

            top: 12px;

            left: 12px;

            padding:
                7px 12px;

            background:
                rgba(0,0,0,0.7);

            border-radius: 6px;

            color: #00ff88;

            font-size: 12px;

            font-weight: bold;

            z-index: 3;
        }


        .divisao-setores {

            position: absolute;

            inset: 0;

            display: grid;

            grid-template-columns: repeat(3, 1fr);

            pointer-events: none;

            z-index: 2;
        }


        .faixa-setor {

            position: relative;

            border-right:
                2px solid rgba(0, 255, 136, 0.9);
        }


        .faixa-setor:last-child {

            border-right: none;
        }


        .rotulo-setor {

            position: absolute;

            bottom: 12px;

            left: 50%;

            transform: translateX(-50%);

            padding: 5px 10px;

            border-radius: 6px;

            background: rgba(0, 0, 0, 0.65);

            color: #00ff88;

            font-size: 12px;

            font-weight: bold;

            letter-spacing: 1px;

            white-space: nowrap;
        }


        /* ==================================================
           SETORES
        ================================================== */

        .setores {

            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 15px;

            padding:
                25px 30px;
        }


        .setor {

            background:
                linear-gradient(
                    145deg,
                    #17231f,
                    #0f1714
                );

            border:
                1px solid #263a33;

            border-radius: 15px;

            padding: 22px;

            text-align: center;

            transition:
                0.25s;
        }


        .setor:hover {

            transform:
                translateY(-4px);

            border-color:
                #00ff88;
        }


        .setor-nome {

            color: #9ba8a3;

            font-size: 13px;

            font-weight: bold;

            letter-spacing: 1.5px;
        }


        .setor-numero {

            margin-top: 10px;

            font-size: 48px;

            font-weight: bold;

            color: #00ff88;
        }


        .setor-descricao {

            color: #74817b;

            font-size: 12px;

            margin-top: 5px;
        }


        .nivel {

            display: inline-block;

            margin-top: 12px;

            padding:
                5px 12px;

            border-radius: 20px;

            font-size: 11px;

            font-weight: bold;
        }


        .baixo {

            background:
                rgba(0,255,136,0.12);

            color: #00ff88;
        }


        .medio {

            background:
                rgba(255,210,60,0.12);

            color: #ffd23c;
        }


        .alto {

            background:
                rgba(255,70,70,0.12);

            color: #ff5c5c;
        }


        /* ==================================================
           FLUXO
        ================================================== */

        .fluxo {

            margin:
                0 30px 25px;

            padding: 25px;

            background: #111a17;

            border:
                1px solid #263a33;

            border-radius: 15px;
        }


        .fluxo h2 {

            font-size: 15px;

            margin-bottom: 20px;
        }


        .barra-container {

            display: grid;

            grid-template-columns:
                40px 1fr 50px;

            align-items: center;

            gap: 10px;

            margin-bottom: 15px;
        }


        .barra-nome {

            font-weight: bold;

            color: #9da9a4;
        }


        .barra-fundo {

            height: 18px;

            background: #26312d;

            border-radius: 20px;

            overflow: hidden;
        }


        .barra {

            height: 100%;

            width: 0%;

            border-radius: 20px;

            transition:
                width 0.5s ease;

            background:
                linear-gradient(
                    90deg,
                    #00a86b,
                    #00ff88
                );
        }


        .barra-valor {

            text-align: right;

            color: #00ff88;

            font-weight: bold;
        }


        /* ==================================================
           RECOMENDAÇÃO
        ================================================== */

        .recomendacao {

            margin:
                0 30px 25px;

            padding: 28px;

            text-align: center;

            border-radius: 15px;

            background:
                linear-gradient(
                    135deg,
                    rgba(0,229,255,0.08),
                    rgba(0,255,136,0.05)
                );

            border:
                1px solid
                rgba(0,229,255,0.25);
        }


        .recomendacao-titulo {

            color: #00e5ff;

            font-size: 13px;

            font-weight: bold;

            letter-spacing: 1.5px;
        }


        .recomendacao-principal {

            margin-top: 12px;

            font-size: 24px;

            font-weight: bold;
        }


        .recomendacao-setor {

            color: #00ff88;
        }


        .recomendacao-info {

            margin-top: 10px;

            color: #899691;

            font-size: 13px;
        }


        /* ==================================================
           ENERGIA
        ================================================== */

        .energia {

            margin:
                0 30px 25px;

            padding: 25px;

            text-align: center;

            background:
                linear-gradient(
                    145deg,
                    #17231f,
                    #0e1512
                );

            border:
                1px solid #263a33;

            border-radius: 15px;
        }


        .energia-titulo {

            color: #00ff88;

            font-size: 13px;

            font-weight: bold;

            letter-spacing: 1px;
        }


        .energia-valor {

            margin-top: 10px;

            font-size: 42px;

            font-weight: bold;

            color: white;
        }


        .energia-unidade {

            color: #7d8984;

            font-size: 13px;
        }


        .energia-info {

            margin-top: 10px;

            color: #697771;

            font-size: 11px;
        }


        /* ==================================================
           BOTÕES
        ================================================== */

        .controles {

            display: flex;

            justify-content: center;

            gap: 15px;

            padding:
                5px 30px 30px;
        }


        button {

            border: none;

            border-radius: 9px;

            padding:
                12px 20px;

            font-weight: bold;

            cursor: pointer;

            transition:
                0.2s;
        }


        button:hover {

            transform:
                translateY(-2px);
        }


        .btn-reset {

            background: #202c28;

            color: white;

            border:
                1px solid #33463e;
        }


        .btn-reset:disabled {

            opacity: 0.6;

            cursor: wait;
        }


        .btn-demo {

            background: #00c878;

            color: #03110b;
        }


        .btn-demo.ativo {

            background: #ff9f43;
        }


        /* ==================================================
           FOOTER
        ================================================== */

        footer {

            padding:
                15px 30px;

            border-top:
                1px solid #20352d;

            display: flex;

            justify-content:
                space-between;

            color: #5f6c67;

            font-size: 11px;
        }


        /* ==================================================
           RESPONSIVO
        ================================================== */

        @media(max-width: 700px) {

            body {

                padding: 10px;
            }


            .header {

                flex-direction:
                    column;

                align-items:
                    flex-start;

                gap: 15px;
            }


            .setores {

                grid-template-columns:
